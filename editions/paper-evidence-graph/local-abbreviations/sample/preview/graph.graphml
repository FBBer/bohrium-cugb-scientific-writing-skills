<graphml xmlns="http://graphml.graphdrawing.org/xmlns"><key id="label" for="node" attr.name="label" attr.type="string" /><key id="type" for="node" attr.name="type" attr.type="string" /><key id="relation" for="edge" attr.name="relation" attr.type="string" /><key id="evidence" for="edge" attr.name="evidence" attr.type="string" /><key id="scope" for="edge" attr.name="scope" attr.type="string" /><key id="polarity" for="edge" attr.name="polarity" attr.type="string" /><graph id="papers" edgedefault="directed"><node id="station"><data key="label">monitoring station</data><data key="type">instrument</data></node><node id="sensor"><data key="label">mirror sensor</data><data key="type">instrument</data></node><node id="level"><data key="label">water level</data><data key="type">quantity</data></node><node id="tilt"><data key="label">plate tilt</data><data key="type">quantity</data></node><edge id="station-level" source="station" target="level"><data key="relation">records</data><data key="scope">April</data><data key="polarity">positive</data><data key="evidence">inlet.md L2 MS recorded water level during April.</data></edge><edge id="sensor-tilt" source="sensor" target="tilt"><data key="relation">records</data><data key="scope">April</data><data key="polarity">positive</data><data key="evidence">mirror.md L2 MS recorded plate tilt during April.</data></edge></graph></graphml>